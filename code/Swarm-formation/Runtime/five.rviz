    Buffer Length: 1
  - Class: rviz/MarkerArray
    Name: Drone 4 actual model and mission labels
    Enabled: true
    Marker Topic: /drone_4/mission/markers
    Queue Size: 5
  - Class: rviz/PointCloud2
    Name: Drone 4 local occupied map
