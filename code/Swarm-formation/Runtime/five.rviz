  - Class: rviz/MarkerArray
    Name: Five-agent formation and stage
    Enabled: true
    Marker Topic: /swarm5/markers
    Queue Size: 2
  Views:
    Current:
      Class: rviz/Orbit
      Name: Drone 0 local follow
      Target Frame: drone_0/base_link
      Distance: 65.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.85
      Yaw: 3.14
      Near Clip Distance: 0.1
    Saved:
    - Class: rviz/TopDownOrtho
      Name: Full 1760 m route
      Target Frame: world
      Scale: 0.6
      X: 880
      Y: 0
      Angle: 0
    - Class: rviz/Orbit
      Name: Drone 0 follow (requires TF)
      Target Frame: drone_0/base_link
      Distance: 45
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.75
      Yaw: 3.14
Window Geometry:
  Width: 1440
  Height: 900
