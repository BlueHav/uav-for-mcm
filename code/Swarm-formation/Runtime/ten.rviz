Panels:
- Class: rviz/Displays
  Help Height: 52
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 438
- Class: rviz/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ''
  Displays:
  - Class: swarm_status_panel/Overlay
    Name: Fleet status overlay
    Enabled: true
  - Alpha: 0.30000001192092896
    Cell Size: 10
    Class: rviz/Grid
    Color: 75; 80; 90
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Local reference grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 30
    Reference Frame: world
    Value: true
  - Class: rviz/TF
    Enabled: true
    Filter (blacklist): ''
    Filter (whitelist): ''
    Frame Timeout: 10
    Frames:
      All Enabled: true
      drone_0/base_link:
        Value: true
      drone_0/camera_frame:
        Value: true
      drone_1/base_link:
        Value: true
      drone_1/camera_frame:
        Value: true
      drone_2/base_link:
        Value: true
      drone_2/camera_frame:
        Value: true
      drone_3/base_link:
        Value: true
      drone_3/camera_frame:
        Value: true
      drone_4/base_link:
        Value: true
      drone_4/camera_frame:
        Value: true
      drone_5/base_link:
        Value: true
      drone_5/camera_frame:
        Value: true
      drone_6/base_link:
        Value: true
      drone_6/camera_frame:
        Value: true
      drone_7/base_link:
        Value: true
      drone_7/camera_frame:
        Value: true
      drone_8/base_link:
        Value: true
      drone_8/camera_frame:
        Value: true
      drone_9/base_link:
        Value: true
      drone_9/camera_frame:
        Value: true
      world:
        Value: true
    Marker Alpha: 1
    Marker Scale: 1
    Name: TF
    Show Arrows: false
    Show Axes: false
    Show Names: false
    Tree:
      world:
        drone_0/base_link:
          drone_0/camera_frame: {}
        drone_1/base_link:
          drone_1/camera_frame: {}
        drone_2/base_link:
          drone_2/camera_frame: {}
        drone_3/base_link:
          drone_3/camera_frame: {}
        drone_4/base_link:
          drone_4/camera_frame: {}
        drone_5/base_link:
          drone_5/camera_frame: {}
        drone_6/base_link:
          drone_6/camera_frame: {}
        drone_7/base_link:
          drone_7/camera_frame: {}
        drone_8/base_link:
          drone_8/camera_frame: {}
        drone_9/base_link:
          drone_9/camera_frame: {}
    Update Interval: 0
    Value: true
